# Runtime del server. Copiar como `.env` en /opt/test/cenit (NO se versiona).
# Un solo .env compartido por api y web (el web solo usa API_URL, que viene del compose).

# ─── Base de datos (MySQL compartido de /opt/shared, red net-shared) ─────────
DB_HOST=mysql_db
DB_PORT=3306
DB_USER=root
DB_ROOT_PASSWORD=__PASSWORD_DEL_MYSQL_COMPARTIDO__
DB_NAME=CENIT
DB_DIALECT=mysql
API_PORT=80

# ─── Sesión + cifrado ────────────────────────────────────────────────────────
SECRET_KEY=__SECRET_FUERTE__
# 32 bytes hex (openssl rand -hex 32). Si se pierde, hay que reconectar Google.
TOKEN_ENCRYPTION_KEY=__64_CHARS_HEX__

# ─── Google OAuth (mismo client de Cloud Console; agregar el redirect de prod) ─
GOOGLE_CLIENT_ID=__CLIENT_ID__
GOOGLE_CLIENT_SECRET=__CLIENT_SECRET__
OAUTH_REDIRECT_URI=https://cenit.sda.ovh/api/auth/callback
ALLOWED_EMAILS=alguien@ejemplo.com

# ─── ETL ─────────────────────────────────────────────────────────────────────
ETL_CRON=0 5 * * *
ENABLE_JOBS=true
GSC_LAG_DAYS=3
TOP_N=20
BACKFILL_MONTHS=16
TZ=America/Argentina/Buenos_Aires
