# Copiá este archivo como .env.deploy.test y completá.
# Los .env.deploy.<env> reales NO se versionan (ver .gitignore).

# ─── Destino SSH del server de test ──────────────────────────────────────────
DEPLOY_USER=usuario
DEPLOY_SERVER=203.0.113.10
DEPLOY_PORT=22
DEPLOY_PATH=/opt/test/cenit
DEPLOY_SSH_KEY=~/.ssh/id_ed25519

# ─── Imagen / registro (GHCR) ────────────────────────────────────────────────
DEPLOY_TAG=TEST
GITHUB_REGISTRY_USER=luiscruz19
# El PAT con write:packages suele venir del entorno (~/.bashrc → export GITHUB_REGISTRY_TOKEN=...).
# Si no, descomentá y completá acá:
# GITHUB_REGISTRY_TOKEN=

# ─── Post-deploy ─────────────────────────────────────────────────────────────
# "true" para correr el seed (sitios del portfolio) después del up. Default false.
DEPLOY_RUN_SEED=false
