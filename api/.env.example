# Puerto interno del contenedor
API_PORT=80

# JWT de sesión del dashboard (make env la genera automáticamente)
SECRET_KEY=change-me

# MySQL compartido de /opt/shared (make env inyecta el password)
DB_HOST=mysql_db
DB_PORT=3306
DB_USER=root
DB_ROOT_PASSWORD=
DB_NAME=CENIT

# Google OAuth — Cloud Console con Analytics Data API, Analytics Admin API y
# Search Console API habilitadas. Ver README para el paso a paso.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# En dev Google solo acepta http sobre localhost (no *.localhost): usa el puerto 4100 mapeado al web.
OAUTH_REDIRECT_URI=http://localhost:4100/api/auth/callback
# Emails habilitados a entrar al dashboard (separados por coma)
ALLOWED_EMAILS=alguien@ejemplo.com

# Cifrado AES-256-GCM del refresh token de Google (32 bytes hex; make env la genera)
TOKEN_ENCRYPTION_KEY=

# ETL
ETL_CRON=0 5 * * *
ENABLE_JOBS=true
# Search Console publica datos con ~2-3 días de retraso
GSC_LAG_DAYS=3
# Top N de páginas/queries que se guarda por sitio/día
TOP_N=20
# Histórico máximo para el backfill (límite real de Search Console: ~16 meses)
BACKFILL_MONTHS=16

# Alertas: se evalúan después del ETL (por defecto 05:30, media hora más tarde)
ALERTS_CRON=30 5 * * *

# SMTP para notificar alertas y enviar reportes.
# Sin esto las alertas se registran igual, pero no se envían por email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Cenit <no-reply@sda.ovh>

# URL pública del dashboard, para los links de los emails
APP_URL=https://cenit.sda.ovh

TZ=America/Argentina/Buenos_Aires

# PageSpeed diario (rendimiento / Core Web Vitals), en su propia hora (es lento)
PERF_CRON=15 6 * * *
# API key de PageSpeed Insights (opcional; sin ella se usa el token de Google).
# Se saca gratis en Google Cloud Console → APIs → PageSpeed Insights API → Credenciales.
PAGESPEED_API_KEY=
